<%# encoding: utf-8 %>
<div class="ci-relations-section" id="ci-relations-<%= ci.id %>">
  <h4><%= l('hrz_cmdb.ci_relations.title') %></h4>

  <% if relations.any? %>
    <table class="list">
      <thead>
        <tr>
          <th><%= l('hrz_cmdb.ci_relations.direction') %></th>
          <th><%= l('hrz_cmdb.ci_relations.relation_type') %></th>
          <th><%= l('hrz_cmdb.ci_relations.related_ci') %></th>
          <th><%= l('hrz_cmdb.fields.b_comment') %></th>
          <% if can_edit %><th></th><% end %>
        </tr>
      </thead>
      <tbody>
        <% relations.each do |rel| %>
          <% is_source = rel.source_ci_id == ci.id %>
          <% other_ci  = is_source ? rel.target_ci : rel.source_ci %>
          <tr id="relation-row-<%= rel.id %>" class="relation-view-row">
            <td><%= is_source ? '&rarr;'.html_safe : '&larr;'.html_safe %></td>
            <td class="relation-type-display">
              <% type_key = is_source ? rel.relation_type : rel.inverse_type %>
              <%= l("hrz_cmdb.ci_relations.types.#{type_key}", default: type_key) %>
            </td>
            <td class="relation-ci-display">
              <a href="#" onclick="HrzCmdb.loadNode('ci', 'ci_<%= other_ci.id %>'); return false;">
                <%= other_ci.tree_label %>
              </a>
            </td>
            <td><%= rel.b_comment %></td>
            <% if can_edit %>
              <td class="relation-actions" style="white-space:nowrap;">
                <% if is_source %>
                  <a href="#" class="icon icon-edit"
                     title="<%= l('hrz_cmdb.ci_relations.edit') %>"
                     onclick="HrzCmdb.editRelation(<%= ci.id %>, <%= rel.id %>); return false;"><%= sprite_icon('edit') %></a>
                <% end %>
                <a href="#" class="icon icon-del"
                   title="<%= l('hrz_cmdb.ci_relations.delete') %>"
                   onclick="HrzCmdb.deleteRelation(<%= ci.id %>, <%= rel.id %>); return false;"><%= sprite_icon('del') %></a>
              </td>
            <% end %>
          </tr>
          <% if can_edit && is_source %>
          <tr id="relation-edit-row-<%= rel.id %>" class="relation-edit-row" style="display:none;">
            <td colspan="5">
              <%= form_tag "/cmdb/cis/#{ci.id}/relations/#{rel.id}", method: :patch,
                           id: "edit-relation-form-#{rel.id}", class: 'ci-relation-edit-form',
                           remote: false do %>
                <div style="display:flex; gap:10px; align-items:flex-end; padding:6px 0;">
                  <div class="form-group" style="margin:0;">
                    <label style="font-size:0.85em;"><%= l('hrz_cmdb.ci_relations.relation_type') %></label>
                    <%= select_tag 'ci_relation[relation_type]',
                                   options_for_select(
                                     HrzcmCiRelation::RELATION_TYPES.map { |t|
                                       [l("hrz_cmdb.ci_relations.types.#{t}", default: t), t]
                                     }, rel.relation_type
                                   ), class: 'form-control form-control-short' %>
                  </div>
                  <div class="form-group" style="margin:0; flex:1;">
                    <label style="font-size:0.85em;"><%= l('hrz_cmdb.ci_relations.related_ci') %></label>
                    <%= select_tag 'ci_relation[related_ci_id]',
                                   options_for_select(
                                     HrzcmCi.ordered_by_abbr.where.not(id: ci.id).map { |c| [c.tree_label, c.id] },
                                     other_ci.id
                                   ), class: 'form-control' %>
                  </div>
                  <div class="form-group" style="margin:0;">
                    <%= submit_tag l('hrz_cmdb.ci_relations.save'), class: 'button button-positive' %>
                    <a href="#" class="button" onclick="HrzCmdb.cancelEditRelation(<%= rel.id %>); return false;">
                      <%= l('hrz_cmdb.ci_relations.cancel') %>
                    </a>
                  </div>
                </div>
              <% end %>
            </td>
          </tr>
          <% end %>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="nodata"><%= l('hrz_cmdb.ci_relations.none') %></p>
  <% end %>

  <% if can_edit %>
    <div class="ci-relation-form">
      <h5><%= l('hrz_cmdb.ci_relations.add') %></h5>
      <%= form_tag "/cmdb/cis/#{ci.id}/relations", method: :post,
                   id: "new-relation-form-#{ci.id}", class: 'ci-relation-new-form' do %>
        <div class="form-group">
          <%= label_tag :relation_type, l('hrz_cmdb.ci_relations.relation_type') %>
          <%= select_tag 'ci_relation[relation_type]',
                         options_for_select(
                           HrzcmCiRelation::RELATION_TYPES.map { |t|
                             [l("hrz_cmdb.ci_relations.types.#{t}", default: t), t]
                           }
                         ), class: 'form-control form-control-short' %>
        </div>
        <div class="form-group">
          <%= label_tag :target_ci_id, l('hrz_cmdb.ci_relations.related_ci') %>
          <%= select_tag 'ci_relation[target_ci_id]',
                         options_for_select(
                           [[l('hrz_cmdb.select_item'), '']] +
                           HrzcmCi.ordered_by_abbr.where.not(id: ci.id).map { |c| [c.tree_label, c.id] }
                         ), class: 'form-control' %>
        </div>
        <div class="form-group">
          <%= label_tag :b_comment, l('hrz_cmdb.fields.b_comment') %>
          <%= text_field_tag 'ci_relation[b_comment]', '', class: 'form-control', maxlength: 1000 %>
        </div>
        <div class="form-actions">
          <%= submit_tag l('hrz_cmdb.ci_relations.add'), class: 'button button-positive',
                         id: "submit-relation-#{ci.id}" %>
        </div>
      <% end %>
    </div>

    <div class="ci-replace-form" style="margin-top:16px; padding-top:12px; border-top:1px solid #ddd;">
      <h5><%= l('hrz_cmdb.ci_relations.replace.title') %></h5>
      <%= form_tag "/cmdb/cis/#{ci.id}/replace", method: :post,
                   id: "replace-ci-form-#{ci.id}", class: 'ci-replace-form-inner' do %>
        <div class="form-group">
          <%= label_tag :new_ci_id, l('hrz_cmdb.ci_relations.replace.new_ci_label') %>
          <%= select_tag 'new_ci_id',
                         options_for_select(
                           [[l('hrz_cmdb.ci_relations.replace.select_placeholder'), '']] +
                           HrzcmCi.ordered_by_abbr.where.not(id: ci.id).map { |c| [c.tree_label, c.id] }
                         ), class: 'form-control' %>
        </div>
        <div class="form-group">
          <%= check_box_tag 'retire_old', '1', false %>
          <%= label_tag 'retire_old', l('hrz_cmdb.ci_relations.replace.retire_old_label') %>
        </div>
        <div class="form-actions">
          <%= submit_tag l('hrz_cmdb.ci_relations.replace.button'), class: 'button button-negative',
                         data: { confirm: l("hrz_cmdb.ci_relations.replace.confirm"), "error-no-ci": l("hrz_cmdb.ci_relations.replace.error_no_ci") },
                         onclick: "return HrzCmdb.replaceCI(#{ci.id});",
                         id: "submit-replace-#{ci.id}" %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
