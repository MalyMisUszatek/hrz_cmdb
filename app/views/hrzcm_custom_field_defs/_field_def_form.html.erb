<%# locals: ci_class, field_def, action_url, method %>
<% wrapper_id = field_def.new_record? ? 'list-values-wrapper-new' : "list-values-wrapper-#{field_def.id}" %>
<%= form_tag action_url, method: method, style: 'width:100%' do %>

  <%# Wiersz 1: pola główne %>
  <div style="display:flex; flex-wrap:nowrap; gap:6px; align-items:flex-end; width:100%;">

    <div style="flex:2; min-width:100px; display:flex; flex-direction:column;">
      <label style="font-size:0.78em;color:#777"><%= l('hrz_cmdb.custom_fields.labels.name') %></label>
      <%= text_field_tag 'field_def[b_name]', field_def.b_name,
          style: 'width:100%', required: true, maxlength: 120 %>
    </div>

    <div style="flex:1.2; min-width:80px; display:flex; flex-direction:column;">
      <label style="font-size:0.78em;color:#777"><%= l('hrz_cmdb.custom_fields.ui_tab') %></label>
      <select name="field_def[ui_tab]" style="width:100%;height:22px;font-size:0.88em">
        <option value="standard" <%= 'selected' if field_def.ui_tab.to_s == 'standard' %>><%= l('hrz_cmdb.custom_fields.ui_tab_standard') %></option>
        <option value="other"    <%= 'selected' if field_def.ui_tab.to_s == 'other' || field_def.ui_tab.blank? %>><%= l('hrz_cmdb.custom_fields.ui_tab_other') %></option>
      </select>
    </div>

    <div style="flex:1.2; min-width:80px; display:flex; flex-direction:column;">
      <label style="font-size:0.78em;color:#777"><%= l('hrz_cmdb.custom_fields.labels.key') %></label>
      <%= text_field_tag 'field_def[b_key]', field_def.b_key,
          style: 'width:100%', required: true, maxlength: 60, pattern: '[a-z0-9_]+' %>
    </div>

    <div style="flex:1.2; min-width:80px; display:flex; flex-direction:column;">
      <label style="font-size:0.78em;color:#777"><%= l('hrz_cmdb.custom_fields.labels.field_type') %></label>
      <%= select_tag 'field_def[field_type]',
          options_for_select(
            HrzcmCiCustomFieldDef::FIELD_TYPES.map { |t|
              [I18n.t("hrz_cmdb.custom_fields.types.#{t}", default: t.capitalize), t]
            }, field_def.field_type),
          style: 'width:100%',
          'data-target' => wrapper_id,
          onchange: 'HrzCmdb.toggleListValues(this)' %>
    </div>

    <div style="flex:0.7; min-width:60px; display:flex; flex-direction:column; align-items:center;">
      <label style="font-size:0.78em;color:#777"><%= l('hrz_cmdb.custom_fields.labels.is_required') %></label>
      <%= check_box_tag 'field_def[is_required]', '1', field_def.is_required, style: 'margin-top:5px' %>
    </div>

    <div style="flex:1.4; min-width:90px; display:flex; flex-direction:column;">
      <label style="font-size:0.78em;color:#777"><%= l('hrz_cmdb.custom_fields.labels.default_value') %></label>
      <%= text_field_tag 'field_def[default_value]', field_def.default_value,
          placeholder: '—', style: 'width:100%', maxlength: 500 %>
    </div>

    <%# Przyciski Zapisz / Anuluj %>
    <div style="flex:0; display:flex; flex-direction:column; align-items:flex-start; gap:2px; padding-bottom:1px;">
      <%= submit_tag(field_def.new_record? ?
            l('hrz_cmdb.custom_fields.buttons.add') :
            l('hrz_cmdb.custom_fields.buttons.save'),
          class: 'button-positive', style: 'white-space:nowrap') %>
      <% unless field_def.new_record? %>
        <a href="#" onclick="HrzCmdb.toggleEditFieldDef(<%= field_def.id %>); return false"
           style="font-size:0.85em;color:#666"><%= l('hrz_cmdb.custom_fields.buttons.cancel') %></a>
      <% end %>
    </div>
  </div>

  <%# Wiersz 2: Opis (zwinięty) %>
  <div style="margin-top:4px;">
    <details <%= field_def.bdescription.present? ? 'open' : '' %>>
      <summary style="font-size:0.78em;color:#aaa;cursor:pointer;list-style:none;display:inline;">
        ▸ <%= l('hrz_cmdb.custom_fields.labels.description') %>
        <% if field_def.bdescription.present? %>
          <em style="color:#bbb"> (<%= field_def.bdescription.truncate(40) %>)</em>
        <% end %>
      </summary>
      <%= text_field_tag 'field_def[bdescription]', field_def.bdescription,
          placeholder: l('hrz_cmdb.custom_fields.labels.description'),
          style: 'width:100%;font-size:0.85em;margin-top:2px', maxlength: 500 %>
    </details>
  </div>

  <%# Opcje listy — tylko gdy type=list %>
  <div id="<%= wrapper_id %>"
       style="display:<%= field_def.field_type == 'list' ? 'block' : 'none' %>; margin-top:4px;">
    <label style="font-size:0.78em;color:#777"><%= l('hrz_cmdb.custom_fields.labels.list_options') %></label>
    <%= text_area_tag 'field_def[list_values]',
        field_def.list_options&.join("\n"),
        rows: 3, style: 'width:100%;font-size:0.85em;margin-top:2px',
        placeholder: 'Option1' %>
  </div>

<% end %>
