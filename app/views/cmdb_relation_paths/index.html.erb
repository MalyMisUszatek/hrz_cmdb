<%= stylesheet_link_tag 'cmdb_theme', plugin: 'hrz_cmdb', cache: false %>
<%= stylesheet_link_tag 'hrz_cmdb', plugin: 'hrz_cmdb', cache: false %>
<%= stylesheet_link_tag 'cmdb_layout_patch', plugin: 'hrz_cmdb', cache: false %>

<%= render partial: 'cmdb/cmdb_tabs' %>

<h2><%= l('hrz_cmdb.relation_paths.title') %></h2>

<div id="cmdb-rp-layout" style="display:flex;gap:16px;align-items:flex-start">

  <!-- LEWY PANEL: filtry -->
  <div id="cmdb-rp-filters" style="min-width:260px;max-width:280px">
    <div class="box" style="padding:12px">
      <p><b>Filtry</b></p>

      <%= form_with url: run_cmdb_relation_paths_path, method: :post, local: true, id: 'relation-paths-form' do %>
        <p>
          <label><b>Klasa CI (punkt startowy)</b></label><br>
          <%= select_tag :ci_class_id,
                options_for_select(@ci_classes.map { |c| [c.b_name_full, c.id] }, params[:ci_class_id]),
                include_blank: '— dowolna —',
                style: 'width:100%' %>
        </p>

        <p>
          <label><b>Typy relacji</b></label><br>
          <%= select_tag 'relation_types[]',
                options_for_select(@relation_types.map { |rt| [rt, rt] }, params[:relation_types]),
                multiple: true,
                style: 'width:100%;height:100px' %><br>
          <em style="font-size:0.85em">(brak zaznaczenia = wszystkie)</em>
        </p>

        <p>
          <label><b>Kierunek</b></label><br>
          <%= select_tag :direction,
                options_for_select([
                  ['↓ do przodu (outgoing)', 'out'],
                  ['↑ do tyłu (incoming)',   'in'],
                  ['↕ obydwa',               'both']
                ], params[:direction] || 'out'),
                style: 'width:100%' %>
        </p>

        <p>
          <label><b>Maks. głębokość</b></label><br>
          <%= number_field_tag :max_depth, params[:max_depth] || 3, min: 1, max: 20, style: 'width:60px' %>
        </p>

        <p>
          <%= submit_tag 'Generuj łańcuch relacji', class: 'button-positive' %>
          <%= link_to 'Resetuj', cmdb_relation_paths_path, class: 'icon icon-reload' %>
        </p>
      <% end %>

      <%# === Filtrowanie węzłów CI (exclude_ci_ids - ID based) === %>
      <% if @ran && @paths.present? %>
        <hr style="margin:12px 0">
        <p><b>Wyklucz węzły CI</b></p>
        <div id="cmdb-rp-node-filter" style="font-size:0.88em;max-height:200px;overflow-y:auto">
          <%
            excluded_ids = Array(params[:exclude_ci_ids]).reject(&:blank?).map(&:to_i)
            # zbierz unikalne CI z wyników - pary [nazwa, id] z @path_query jeśli dostępne
            # @excluded_cis to [{id:, name:}] - uzupełniamy o wszystkie CI z ścieżek
            # pobieramy CI których nazwy pojawiają się w wynikach
            path_ci_names = @paths.flat_map.with_index { |path, _|
              path.each_with_index.select { |_, i| i.even? }.map(&:first)
            }.uniq.sort
            path_cis = HrzcmCi.where('b_name_abbr IN (?) OR b_name_full IN (?)',
                                      path_ci_names, path_ci_names)
                               .map { |ci| [ci.b_name_abbr.presence || ci.b_name_full, ci.id] }
                               .sort_by(&:first)
          %>
          <% path_cis.each do |name, ci_id| %>
            <label style="display:block;margin:2px 0">
              <input type="checkbox"
                     name="exclude_ci_ids[]"
                     value="<%= ci_id %>"
                     form="relation-paths-form"
                     <%= 'checked' if excluded_ids.include?(ci_id) %>>
              <%= name %>
            </label>
          <% end %>
        </div>
        <p style="margin-top:6px">
          <button type="submit" form="relation-paths-form" class="button">Zastosuj filtr</button>
        </p>
      <% end %>
    </div>
  </div>

  <!-- PRAWY PANEL: wyniki -->
  <div id="cmdb-rp-results" style="flex:1;min-width:0">
    <% if @ran %>
      <% if @paths.present? %>
        <div style="margin-bottom:8px">
          <strong><%= @paths.length %> ścieżek</strong>
          &nbsp;
          <%= link_to '⬇ Eksport CSV',
                run_cmdb_relation_paths_path(params.permit(:ci_class_id, :max_depth, :direction).merge(format: :csv)),
                class: 'icon icon-download' %>
        </div>
        <style>
          #cmdb-rp-table td { vertical-align: top; }
          #cmdb-rp-table td.rp-same { color: #ccc; font-size:0.8em; }
          #cmdb-rp-table td.rp-ci   { font-weight: bold; }
          #cmdb-rp-table td.rp-rel  { color: #555; font-style: italic; font-size:0.9em; }
          #cmdb-rp-table td.rp-empty { border-right: none; }
          #cmdb-rp-table tr td { border-top: 1px solid #eee; }
          #cmdb-rp-table tr:first-child td { border-top: none; }
        </style>
        <div style="overflow-x:auto">
          <%
            max_len = @paths.map(&:length).max || 0
          %>
          <table class="list" id="cmdb-rp-table">
            <thead>
              <tr>
                <% (0...max_len).each do |i| %>
                  <th><%= i.even? ? "CI #{i/2 + 1}" : "relacja #{i/2 + 1}" %></th>
                <% end %>
              </tr>
            </thead>
            <tbody>
              <% @paths.each_with_index do |path, row_idx| %>
                <tr>
                  <% (0...max_len).each do |col| %>
                    <% cell_val = path[col].to_s %>
                    <% is_ci = col.even? %>
                    <%
                      # Pokazuj " tylko gdy prefiks 0..col-1 jest taki sam (kontekst ukryty)
                      # ale sama wartość w tej kolumnie też musi być taka sama
                      # ORAZ poprzedni wiersz musiał mieć tę samą wartość w tej kolumnie
                      same_as_prev = row_idx > 0 &&
                        cell_val == @paths[row_idx - 1][col].to_s &&
                        (0...col).all? { |c| @paths[row_idx][c].to_s == @paths[row_idx - 1][c].to_s }
                    %>
                    <% if cell_val.blank? %>
                      <td class="rp-empty"></td>
                    <% elsif same_as_prev %>
                      <td class="<%= is_ci ? 'rp-ci' : 'rp-rel' %> rp-same">&rdquo;</td>
                    <% else %>
                      <td class="<%= is_ci ? 'rp-ci' : 'rp-rel' %>"><%= cell_val %></td>
                    <% end %>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="nodata">Brak ścieżek dla wybranych filtrów.</p>
      <% end %>
    <% else %>
      <div class="nodata" style="padding:40px;text-align:center;color:#888">
        Wybierz filtry i kliknij <strong>Generuj łańcuch relacji</strong>
      </div>
    <% end %>
  </div>

</div>
